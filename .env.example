# Domain only, no scheme or path. DNS A/AAAA must point to this VPS.
MCP_DOMAIN=battle.example.com
# Generate on the VPS with: openssl rand -hex 32
TB_MCP_TOKEN=
# Use the exact origin shown in the TT panel's MCP settings. Comma separated.
TB_MCP_ORIGINS=http://tauri.localhost,https://tauri.localhost,tauri://localhost,http://localhost:8000,http://127.0.0.1:8000
